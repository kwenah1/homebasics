# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://homebasics:homebasics@localhost:5432/homebasics
TEST_DATABASE_URL=postgresql+psycopg://homebasics:homebasics@localhost:5432/homebasics_test
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
# Enables /api/v1/test/* (reset + seed). Always off in prod.
ENABLE_TEST_ENDPOINTS=true

# --- Deployment (M9; all optional in dev) --------------------------------------------------
# Shared rate-limit store. Without it the limit is per-process (fine for one instance).
# REDIS_URL=redis://default:password@host:6379
# Outbox delivery. Without SMTP_HOST, emails stay in the table and /test/emails can read them.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=...
# EMAIL_FROM=HomeBasics <no-reply@example.com>
# In-process worker: expiry sweep + outbox delivery.
# WORKER_ENABLED=true
# WORKER_INTERVAL_SECONDS=60
# SENTRY_DSN=

